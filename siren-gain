#!/usr/bin/env python3
"""Control the hardware gain of a Razer Seiren V3 (Chroma) over PipeWire.

The mic exposes a hardware control called "Mic Capture Volume" (ALSA).
PipeWire/WirePlumber maps its node volume to that hardware control using

    dB = dBmax + 60 * log10(volume)

so this tool converts between decibels and the PipeWire volume that GNOME and
`wpctl` use, and stores the chosen level so it can be re-applied at login.

Usage:
    siren-gain                  show current gain and saved value
    siren-gain -6               set gain to -6 dB and remember it
    siren-gain --save-current   remember whatever the current gain is
    siren-gain --apply          apply the saved gain (used by the login service)
"""

import glob
import json
import math
import os
import re
import subprocess
import sys
import time

CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
CONFIG_FILE = os.path.join(CONFIG_HOME, "siren-gain", "gain-db")
DEFAULT_DB = 0.0

FALLBACK_RANGE = (-17.62, 15.00)  # dB, used only if /proc is unavailable


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def find_source():
    """Return (node_id, channel_volume) for the Razer Seiren V3 source node.

    PipeWire keeps the hardware volume in channelVolumes (the "soft" volume
    stays at 1.0), so that is the value we must read.
    """
    out = run(["pw-dump"]).stdout
    try:
        data = json.loads(out)
    except ValueError:
        return None
    for obj in data:
        if obj.get("type") != "PipeWire:Interface:Node":
            continue
        props = (obj.get("info") or {}).get("props") or {}
        name = (props.get("node.name") or "").lower()
        if "razer" in name and "seiren" in name and props.get("media.class") == "Audio/Source":
            params = (obj.get("info") or {}).get("params") or {}
            node_props = (params.get("Props") or [{}])[0]
            volumes = node_props.get("channelVolumes") or [node_props.get("volume", 1.0)]
            return obj["id"], float(volumes[0])
    return None


def gain_range():
    """Read the hardware dB range from the USB mixer descriptor."""
    for path in sorted(glob.glob("/proc/asound/card*/usbmixer")):
        try:
            with open(path) as fh:
                text = fh.read()
        except OSError:
            continue
        if "Razer Seiren" not in text:
            continue
        match = re.search(
            r'name="Mic Capture Volume".*?dBmin=(-?\d+),\s*dBmax=(-?\d+)',
            text,
            re.S,
        )
        if match:
            return int(match.group(1)) / 100.0, int(match.group(2)) / 100.0
    return FALLBACK_RANGE


def vol_to_db(channel_volume, low, high):
    # channel_volume == (node volume)^3, and dB = high + 60*log10(node volume)
    if channel_volume <= 0:
        return low
    return high + 20.0 * math.log10(channel_volume)


def db_to_vol(db, low, high):
    db = max(low, min(high, db))
    return 10.0 ** ((db - high) / 60.0)


def read_saved():
    try:
        with open(CONFIG_FILE) as fh:
            return float(fh.read().strip())
    except (OSError, ValueError):
        return DEFAULT_DB


def write_saved(db):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    with open(CONFIG_FILE, "w") as fh:
        fh.write(f"{db:.2f}\n")


def set_db(db):
    source = find_source()
    if not source:
        return False
    low, high = gain_range()
    volume = db_to_vol(db, low, high)
    result = run(["wpctl", "set-volume", str(source[0]), f"{volume:.6f}"])
    return result.returncode == 0


def current_db():
    source = find_source()
    if not source:
        return None
    low, high = gain_range()
    return vol_to_db(source[1], low, high)


def cmd_show():
    low, high = gain_range()
    source = find_source()
    saved = read_saved()
    if not source:
        print("Razer Seiren V3 source not found.")
        print(f"Saved gain: {saved:+.2f} dB")
        return 1
    db = vol_to_db(source[1], low, high)
    print("Razer Seiren V3 Chroma")
    print(f"  current : {db:+.2f} dB  (node {source[0]})")
    print(f"  saved   : {saved:+.2f} dB")
    print(f"  range   : {low:+.2f} .. {high:+.2f} dB")
    return 0


def cmd_set(db):
    low, high = gain_range()
    clamped = max(low, min(high, db))
    if abs(clamped - db) > 1e-6:
        print(f"Note: clamped {db:+.2f} dB to range {low:+.2f} .. {high:+.2f} dB", file=sys.stderr)
    if not set_db(clamped):
        print("Failed to set gain: Razer Seiren V3 source not found.", file=sys.stderr)
        return 1
    write_saved(clamped)
    print(f"Gain set to {clamped:+.2f} dB and saved.")
    return 0


def cmd_save_current():
    db = current_db()
    if db is None:
        print("Failed to read gain: Razer Seiren V3 source not found.", file=sys.stderr)
        return 1
    write_saved(db)
    print(f"Saved current gain: {db:+.2f} dB")
    return 0


def cmd_apply():
    """Apply the saved gain, waiting for the device and for WirePlumber to settle."""
    saved = read_saved()
    for _ in range(60):  # up to ~30 seconds
        if set_db(saved):
            time.sleep(0.5)
            now = current_db()
            if now is not None and abs(now - saved) < 0.2:
                # Make sure nothing else (WirePlumber restoring its own state)
                # overrides us right after we set it.
                time.sleep(1.0)
                now = current_db()
                if now is not None and abs(now - saved) < 0.2:
                    return 0
        time.sleep(0.5)
    print(f"Could not apply saved gain {saved:+.2f} dB.", file=sys.stderr)
    return 1


def main(argv):
    if not argv:
        return cmd_show()
    arg = argv[0]
    if arg in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if arg == "--apply":
        return cmd_apply()
    if arg == "--save-current":
        return cmd_save_current()
    try:
        db = float(arg)
    except ValueError:
        print(f"Not a number: {arg}", file=sys.stderr)
        return 2
    return cmd_set(db)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
